map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen 80;
	server_name _;

	return 301 https://$host:${NGINX_HTTPS_PORT}$request_uri;
}

server {
	listen 443 ssl;
	http2 on;
	server_name _;

	ssl_certificate     /etc/nginx/certs/selfsigned.crt;
	ssl_certificate_key /etc/nginx/certs/selfsigned.key;

	ssl_protocols       TLSv1.2 TLSv1.3;
	ssl_ciphers         HIGH:!aNULL:!MD5;
	ssl_session_cache   shared:SSL:10m;
	ssl_session_timeout 1d;

	client_max_body_size ${NGINX_MAX_BODY_SIZE};

	add_header Strict-Transport-Security  "max-age=31536000" always;
	add_header X-Content-Type-Options     "nosniff" always;
	add_header X-Frame-Options            "DENY" always;
	add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
	add_header Cross-Origin-Opener-Policy "same-origin" always;
	add_header Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ws: wss:; form-action 'self'" always;

	server_tokens off;

	location /api/ {
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend:9000;
		proxy_buffering off;
	}

	location /socket.io/ {
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend:9000;
		proxy_read_timeout 7d;
		proxy_send_timeout 7d;
	}

	location = /health {
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://backend:9000/health;
		access_log off;
	}

	location / {
		include /etc/nginx/snippets/proxy.conf;
		proxy_pass http://frontend:5173;
		proxy_read_timeout 1d;
		proxy_send_timeout 1d;
	}
}
