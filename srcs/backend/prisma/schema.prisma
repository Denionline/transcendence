// note: `npx prisma validate` to check the schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  artist
  hirer
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String?
  role         UserRole @default(artist)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  artistProfile   ArtistProfile?
  hirerProfile    HirerProfile?
  files           File[]
  gigs            Gig[]          @relation("GigsPosted")
  swipesMade      Swipe[]        @relation("SwipesMade")
  swipesReceived  Swipe[]        @relation("SwipesReceived")
  matchesAsArtist Match[]        @relation("MatchesAsArtist")
  notificationsTriggered Notification[] @relation("NotificationActor") 

  chatMessages  ChatMessage[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  loginAttempts LoginAttempt[]

  friendRequestsSent     Friend[] @relation("FriendRequestsSent")
  friendRequestsReceived Friend[] @relation("FriendRequestsReceived")
}

// The controlled vocabulary. `slug` is the stable matching/lookup key,
// `label` is what the UI shows — renaming a category is a one-row UPDATE
// that breaks no existing match. See docs/mad/20260810-categories.md.
model Category {
  id        String   @id @default(uuid())
  slug      String   @unique
  label     String
  createdAt DateTime @default(now())

  artists ArtistCategory[]
  hirers  HirerCategory[]
  gigs    Gig[]
}

// The composite primary key is the deduplication: an artist cannot hold the
// same category twice, so no application-level check is needed.
model ArtistCategory {
  artistProfileId String
  artistProfile   ArtistProfile @relation(fields: [artistProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([artistProfileId, categoryId])
  @@index([categoryId])
}

model HirerCategory {
  hirerProfileId String
  hirerProfile   HirerProfile @relation(fields: [hirerProfileId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([hirerProfileId, categoryId])
  @@index([categoryId])
}

model ArtistProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio          String?
  location     String?
  availability Boolean  @default(true)
  createdAt    DateTime @default(now())

  categories ArtistCategory[]

  @@index([availability])
}

model HirerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationName String
  bio              String?
  location         String?
  availability     Boolean  @default(true)
  createdAt        DateTime @default(now())

  categories HirerCategory[]
}

enum FileType {
  image
  audio
  video
  document
}

// `visibility` governs *discovery*, not retrieval: it decides what the listing
// and profile endpoints disclose. The bytes route serves any id it is given,
// because the id itself is the capability. See docs/mad/20260819-file-uploads.md.
enum FileVisibility {
  private
  public
}

model File {
  id           String         @id @default(uuid())
  ownerId      String
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type         FileType
  mimeType     String
  sizeBytes    Int
  originalName String
  location     String
  visibility   FileVisibility @default(private)
  createdAt    DateTime       @default(now())

  // The portfolio query: an artist's public files, newest first.
  @@index([ownerId, visibility])
}

enum GigStatus {
  open
  closed
}

model Gig {
  id          String    @id @default(uuid())
  hirerId     String
  hirer       User      @relation("GigsPosted", fields: [hirerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location    String?
  rate        Int?
  status      GigStatus @default(open)
  createdAt   DateTime  @default(now())

  swipes  Swipe[]
  matches Match[]

  @@index([status, createdAt])
  @@index([status, categoryId])
  @@index([categoryId])
}

model Swipe {
  id        String   @id @default(uuid())
  swiperId  String
  swiper    User     @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  swipedId  String
  swiped    User     @relation("SwipesReceived", fields: [swipedId], references: [id], onDelete: Cascade)
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  liked     Boolean
  createdAt DateTime @default(now())

  @@unique([gigId, swipedId, swiperId])
}

model Match {
  id        String   @id @default(uuid())
  artistId  String
  artist    User     @relation("MatchesAsArtist", fields: [artistId], references: [id], onDelete: Cascade)
  gigId     String
  gig       Gig      @relation(fields: [gigId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@unique([artistId, gigId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum NotificationType {
  new_match
  new_message
  gig_closed
  swipe_liked
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId	String?
  actor  	User?  			   @relation("NotificationActor", fields: [actorId], references: [id])
  type      NotificationType
  data      Json?
  isRead    Boolean           @default(false)
  createdAt DateTime          @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

enum FriendRequestStatus {
  pending
  accepted
  declined
}

model Friend {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation("FriendRequestsSent", fields: [userId], references: [id], onDelete: Cascade)
  friendId  String
  friend    User                @relation("FriendRequestsReceived", fields: [friendId], references: [id], onDelete: Cascade)
  status    FriendRequestStatus @default(pending)
  createdAt DateTime            @default(now())

  @@unique([userId, friendId])
  @@index([friendId, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id         String   @id @default(uuid())
  email      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  successful Boolean
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}