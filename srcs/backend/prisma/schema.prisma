// note: `npx prisma validate` to check the schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  artist
  hirer
  admin
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String
  passwordHash String?
  role         UserRole @default(artist)
  avatarUrl    String?
  createdAt    DateTime @default(now())

  artistProfile   ArtistProfile?
  hirerProfile    HirerProfile?
  files           File[]
  gigs            Gig[]          @relation("GigsPosted")
  swipesMade      Swipe[]        @relation("SwipesMade")
  swipesReceived  Swipe[]        @relation("SwipesReceived")
  matchesAsArtist Match[]        @relation("MatchesAsArtist")

  chatMessages  ChatMessage[]
  refreshTokens RefreshToken[]
  loginAttempts LoginAttempt[]
}

model ArtistProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  bio          String?
  location     String?
  availability Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model HirerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String
  organizationName String
  bio              String?
  location         String?
  availability     Boolean  @default(true)
  createdAt        DateTime @default(now())
}

enum FileType {
  image
  audio
  video
  document
}

model File {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type      FileType
  location  String
  createdAt DateTime @default(now())
}

enum GigStatus {
  open
  closed
}

model Gig {
  id          String    @id @default(uuid())
  hirerId     String
  hirer       User      @relation("GigsPosted", fields: [hirerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  category    String
  location    String?
  rate        Int?
  status      GigStatus @default(open)
  createdAt   DateTime  @default(now())

  swipes  Swipe[]
  matches Match[]
}

model Swipe {
  id            String      @id @default(uuid())
  swiperId      String
  swiper        User        @relation("SwipesMade", fields: [swiperId], references: [id], onDelete: Cascade)
  artistId      String
  artist        User        @relation("SwipesReceived", fields: [artistId], references: [id], onDelete: Cascade)
  gigId         String
  gig           Gig         @relation(fields: [gigId], references: [id], onDelete: Cascade)
  liked         Boolean
  createdAt     DateTime    @default(now())

  @@unique([gigId, artistId, swiperId])
}

model Match {
  id            String      @id @default(uuid())
  artistId      String
  artist        User        @relation("MatchesAsArtist", fields: [artistId], references: [id], onDelete: Cascade)
  gigId         String
  gig           Gig         @relation(fields: [gigId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  messages ChatMessage[]

  @@unique([artistId, gigId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  matchId   String
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id         String   @id @default(uuid())
  email      String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  successful Boolean
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([createdAt])
}
