// note: `npx prisma validate` to check the schema
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole{
  artist
  hirer
  admin
}

model User {
  id                  String    @id       @default(uuid())
  email               String    @unique
  username            String
  passwordHash        String
  role                UserRole            @default(artist)
  avatarUrl           String?
  createdAt           DateTime            @default(now())
  artistProfile       ArtistProfile?
  hirerProfile        HirerProfile?
}

model ArtistProfile {
  id                  String    @id       @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  category            String
  bio                 String?
  location            String?
  rate                String?
  availability        Boolean   @default(true)
  createdAt           DateTime  @default(now())
}

model HirerProfile {
  id                  String    @id       @default(uuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
  category            String
  organizationName    String?
  bio                 String?
  location            String?
  availability        Boolean   @default(true)
  createdAt           DateTime  @default(now())
}
