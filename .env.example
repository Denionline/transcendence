# Postgres. Use a strong POSTGRES_PASSWORD in production.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host port the database is published on (loopback only). Optional, default 5432.
POSTGRES_HOST_PORT=

# Ports nginx publishes on the host. Optional, defaults 8080 / 8443.
HTTP_PORT=
HTTPS_PORT=

# 42 OAuth application credentials.
# FT_API_CALLBACK_URL must be reachable through nginx and registered on the
# 42 application, e.g. https://<host>:<HTTPS_PORT>/api/auth/42/callback
FT_API_UID=
FT_API_SECRET=
FT_API_CALLBACK_URL=

# Use long random values in production.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public origin of the app (nginx), e.g. https://<host>:<HTTPS_PORT>
# Used for CORS and the OAuth redirects.
FRONTEND_URL=

DATABASE_URL=

UPLOAD_DIR=
MAX_UPLOAD_MB=

# Optional: serve real TLS certificates instead of the baked-in self-signed
# pair. Point these at the paths mounted into the nginx container (see the
# commented volume in srcs/docker-compose.yml) and uncomment that volume.
NGINX_SSL_CERT=
NGINX_SSL_KEY=
